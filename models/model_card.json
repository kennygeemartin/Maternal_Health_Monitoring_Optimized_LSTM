{
  "model": "Proposed LSTM (optimised bidirectional feature-serialised)",
  "feature_order": [
    "Age",
    "Body Temperature(F)",
    "Heart rate(bpm)",
    "Systolic Blood Pressure(mm Hg)",
    "Diastolic Blood Pressure(mm Hg)",
    "BMI(kg/m 2)",
